@page "/Account/ForgotPassword"

@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@using Ledgerly.Services.Email

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject IEmailService Email
@inject EmailLinks Links
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ForgotPassword> Logger

<PageTitle>Forgot password · Ledgerly</PageTitle>

<div class="acct-card">
    <h1 class="acct-title">Forgot your password?</h1>

    @if (!emailConfigured)
    {
        <div class="acct-alert acct-alert-warning" role="alert">
            Password reset by email isn't available because Ledgerly's admin hasn't set up an email server yet.
        </div>
    }
    else
    {
        <p class="acct-lead">Enter your account's email and we'll send you a link to choose a new password.</p>
        <StatusMessage Message="@message" />
        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <div class="acct-field">
                <label for="Input.Email">Email</label>
                <InputText @bind-Value="Input.Email" id="Input.Email" class="acct-input" autocomplete="username" aria-required="true" />
                <ValidationMessage For="() => Input.Email" />
            </div>
            <button type="submit" class="acct-btn acct-btn-primary acct-btn-block">Send reset link</button>
        </EditForm>
    }

    <p class="acct-footer"><a href="Account/Login">Back to sign in</a></p>
</div>

@code {
    private string? message;
    private bool emailConfigured;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        emailConfigured = await Email.IsConfiguredAsync();
    }

    private async Task OnValidSubmitAsync()
    {
        if (!emailConfigured)
            return;

        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            // Don't reveal whether an account exists.
            RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
            return;
        }

        // Accounts aren't email-confirmed at sign-up (there was no email server then). Receiving this link
        // proves ownership of the address, and a successful reset marks the email as confirmed.
        var code = await UserManager.GeneratePasswordResetTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var resetLink = await Links.BuildAsync("Account/ResetPassword", new Dictionary<string, object?> { ["code"] = code });

        try
        {
            await EmailSender.SendPasswordResetLinkAsync(user, Input.Email, resetLink);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Couldn't send a password reset email.");
            message = "Error: The email couldn't be sent right now. Try again later.";
            return;
        }

        RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}
