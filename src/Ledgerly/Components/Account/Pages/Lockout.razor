@page "/Account/Lockout"

<PageTitle>Account locked · Ledgerly</PageTitle>

<div class="acct-card">
    <h1 class="acct-title">Account temporarily locked</h1>
    <div class="acct-alert acct-alert-danger" role="alert">
        Too many unsuccessful sign-in attempts. Wait a few minutes and try again.
    </div>
    <a href="Account/Login" class="acct-btn acct-btn-primary acct-btn-block">Back to sign in</a>
</div>
