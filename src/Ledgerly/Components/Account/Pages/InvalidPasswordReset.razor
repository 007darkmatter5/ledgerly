@page "/Account/InvalidPasswordReset"

<PageTitle>Invalid reset link · Ledgerly</PageTitle>

<div class="acct-card">
    <h1 class="acct-title">That reset link doesn't work</h1>
    <div class="acct-alert acct-alert-danger" role="alert">
        The link is incomplete or has been changed. Copy the whole link from the email, or request a new one.
    </div>
    <a href="Account/ForgotPassword" class="acct-btn acct-btn-primary acct-btn-block">Request a new link</a>
</div>
