@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Check your email · Ledgerly</PageTitle>

<div class="acct-card">
    <h1 class="acct-title">Check your email</h1>
    <p class="acct-lead">
        If there's a Ledgerly account for that address, we've sent a link to reset its password.
        It can take a few minutes to arrive; check your spam folder too.
    </p>
    <a href="Account/Login" class="acct-btn acct-btn-primary acct-btn-block">Back to sign in</a>
</div>
