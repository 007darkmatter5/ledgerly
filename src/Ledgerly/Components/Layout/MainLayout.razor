@inherits LayoutComponentBase
@implements IDisposable
@using System.Security.Claims
@inject LedgerService Ledger
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject AppInfo App
@inject SharingNotifier Notifier

<MudThemeProvider @ref="_themeProvider" Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="() => _drawerOpen = !_drawerOpen" aria-label="Toggle navigation" />
        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Class="ml-2 mr-2" />
        <MudText Typo="Typo.h6">Ledgerly</MudText>
        @if (App.IsBeta)
        {
            <MudTooltip Text="@($"Beta build {App.Version}. For testing updates before they reach production.")">
                <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Class="ml-3" Icon="@Icons.Material.Filled.BugReport">Beta</MudChip>
            </MudTooltip>
        }
        @if (_ledger?.IsSample == true)
        {
            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="ml-3" Icon="@Icons.Material.Filled.Science">Sample data</MudChip>
        }
        <MudSpacer />
        @if (_email is not null)
        {
            <MudTooltip Text="Add a transaction">
                <MudIconButton Icon="@Icons.Material.Filled.AddCard" Color="Color.Inherit" OnClick="AddTransactionAsync" aria-label="Add a transaction" />
            </MudTooltip>
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" ListClass="ledgers-menu">
                <ActivatorContent>
                    <MudTooltip Text="@(_invitations.Count > 0 ? "Ledgers: someone shared a ledger with you" : "Ledgers")">
                        <MudBadge Content="_invitations.Count" Visible="_invitations.Count > 0" Color="Color.Error" Overlap="true">
                            <button type="button" class="appbar-button" aria-label="Ledgers" @onclick="@(e => context.ToggleAsync(e))">
                                <MudIcon Icon="@Icons.Material.Filled.Layers" />
                            </button>
                        </MudBadge>
                    </MudTooltip>
                </ActivatorContent>
                <ChildContent>
                    <div class="px-4 pt-2 pb-2">
                        <MudText Typo="Typo.subtitle2">Ledgers</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Choose which to show alongside yours.</MudText>
                    </div>
                    <div class="ledgers-menu-row">
                        <MudIcon Icon="@Icons.Material.Filled.CheckBox" Color="Color.Primary" />
                        <div class="ledgers-menu-text">
                            <div class="ledgers-menu-name">@(_ledger?.IsSample == true ? "Sample data" : "My ledger")</div>
                            <div class="ledgers-menu-sub">Always shown</div>
                        </div>
                    </div>
                    @if (_ledger?.IsSample == true && _scope.Shared.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Class="px-4 pb-2 d-block mud-text-secondary">Shared ledgers are hidden while you explore sample data.</MudText>
                    }
                    else
                    {
                        @foreach (var shared in _scope.Shared)
                        {
                            <MudMenuItem AutoClose="false" OnClick="() => SetVisibleAsync(shared.MemberId, !shared.IsVisible)">
                                <div class="ledgers-menu-row p-0" style="@($"--ledger-color:{shared.Color}")" title="@($"{shared.Name}, shared by {shared.OwnerName}")"
                                     role="checkbox" aria-checked="@(shared.IsVisible ? "true" : "false")" aria-label="@($"{shared.Name}, shared by {shared.OwnerName}")">
                                    <MudIcon Icon="@(shared.IsVisible ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)" Class="ledger-check" />
                                    <div class="ledgers-menu-text">
                                        <div class="ledgers-menu-name">@shared.Name</div>
                                        <div class="ledgers-menu-sub">@shared.OwnerName@(shared.IsReadOnly ? " · view only" : "")</div>
                                    </div>
                                </div>
                            </MudMenuItem>
                        }
                        @if (_scope.Shared.Count > 1)
                        {
                            <MudMenuItem AutoClose="false" Icon="@Icons.Material.Filled.PersonOutline" OnClick="() => SetVisibleAsync(null, false)">Only mine</MudMenuItem>
                            <MudMenuItem AutoClose="false" Icon="@Icons.Material.Filled.Layers" OnClick="() => SetVisibleAsync(null, true)">Show all</MudMenuItem>
                        }
                    }
                    @foreach (var invitation in _invitations)
                    {
                        <MudDivider />
                        <div class="px-4 py-2">
                            <MudText Typo="Typo.body2"><strong>@invitation.OwnerName</strong> wants to share their ledger with you (view only).</MudText>
                            <div class="d-flex gap-2 mt-1">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="() => RespondAsync(invitation, true)">Accept</MudButton>
                                <MudButton Size="Size.Small" OnClick="() => RespondAsync(invitation, false)">Decline</MudButton>
                            </div>
                        </div>
                    }
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Share" Href="sharing">Sharing settings</MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
        <MudTooltip Text="@(_isDarkMode ? "Light mode" : "Dark mode")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="() => _isDarkMode = !_isDarkMode" aria-label="Toggle dark mode" />
        </MudTooltip>
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <button type="button" class="avatar-button ml-2" aria-label="Account menu" @onclick="@(e => context.ToggleAsync(e))">
                    <MudAvatar Color="Color.Secondary" Size="Size.Small">@Initial</MudAvatar>
                </button>
            </ActivatorContent>
            <ChildContent>
                <div class="px-4 pt-2 pb-2">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Signed in as</MudText>
                    <MudText Typo="Typo.body2">@_email</MudText>
                </div>
                <MudDivider />
                <MudMenuItem Icon="@(_ledger?.IsSample == false ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)"
                             OnClick="() => SwitchLedgerAsync(sample: false)">My ledger</MudMenuItem>
                @if (_hasSample)
                {
                    <MudMenuItem Icon="@(_ledger?.IsSample == true ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)"
                                 OnClick="() => SwitchLedgerAsync(sample: true)">Sample data</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.DeleteSweep" IconColor="Color.Error" OnClick="DeleteSampleAsync">Delete sample data</MudMenuItem>
                }
                else
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.Science" OnClick="StartSampleAsync">Explore sample data</MudMenuItem>
                }
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.ManageAccounts" Href="Account/Manage" ForceLoad="true">Account settings</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="SignOutAsync">Sign out</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Responsive">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        @if (_ledger?.IsSample == true)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Square="true" Icon="@Icons.Material.Filled.Science" Class="sample-banner">
                <div class="d-flex flex-wrap align-center gap-2">
                    <span><strong>You're exploring sample data.</strong> It's kept completely separate from your own ledger, so nothing here affects your real data.</span>
                    <MudSpacer />
                    <div class="d-flex flex-wrap gap-2">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Inherit" OnClick="StartSampleAsync">Start over</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Inherit" OnClick="DeleteSampleAsync">Delete sample data</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Dark" OnClick="() => SwitchLedgerAsync(sample: false)">Go to my ledger</MudButton>
                    </div>
                </div>
            </MudAlert>
        }
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @* Re-keyed after a quick-add or a sharing change so the page underneath reloads its data. *@
            <CascadingValue Value="_scope">
                <CascadingValue Name="RefreshLedgers" Value="_refreshLedgers">
                    <div @key="_bodyVersion">
                        @Body
                    </div>
                </CascadingValue>
            </CascadingValue>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@* Sign-out must be a real form post so the server can clear the auth cookie. *@
<form id="logout-form" action="Account/Logout" method="post" hidden>
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="" />
</form>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    private MudThemeProvider? _themeProvider;
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private string? _email;
    private Ledger? _ledger;
    private bool _hasSample;
    private int _bodyVersion;
    private string? _userId;
    private LedgerScope _scope = LedgerScope.None;
    private List<LedgerInvitation> _invitations = [];
    private readonly HashSet<int> _prompted = [];
    private Func<Task> _refreshLedgers = null!;

    private string Initial => string.IsNullOrEmpty(_email) ? "?" : _email[..1].ToUpperInvariant();

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2E7D5B",
            Secondary = "#3F6FB5",
            AppbarBackground = "#1F5A41"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#5FBF8F",
            Secondary = "#7FA8E0"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        // Pages that change sharing (the Sharing page) call this so the Ledgers menu and the page reload.
        _refreshLedgers = async () =>
        {
            await RefreshSharingAsync();
            StateHasChanged();
        };

        var state = await AuthenticationState;
        if (state.User.Identity?.IsAuthenticated != true)
            return;

        _email = state.User.Identity.Name;
        _userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        _ledger = await Ledger.GetActiveLedgerAsync();
        _hasSample = await Ledger.HasSampleLedgerAsync();
        await LoadSharingAsync();
        Notifier.Changed += OnSharingChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        if (_themeProvider is not null)
        {
            _isDarkMode = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
        await PromptInvitationsAsync();
    }

    public void Dispose() => Notifier.Changed -= OnSharingChanged;

    private async Task LoadSharingAsync()
    {
        _scope = await Ledger.GetScopeAsync();
        _invitations = await Ledger.GetInvitationsAsync();
    }

    /// <summary>Reloads the shared ledgers and the page after a change, like switching one on or off.</summary>
    private async Task RefreshSharingAsync()
    {
        await LoadSharingAsync();
        _bodyVersion++;
    }

    // Another user shared, unshared or answered: update this tab straight away.
    private void OnSharingChanged(string userId)
    {
        if (userId != _userId)
            return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await RefreshSharingAsync();
                StateHasChanged();
                await PromptInvitationsAsync();
            }
            catch (Exception)
            {
                // The page picks the change up on its next load; a background refresh must never break the session.
            }
        });
    }

    /// <summary>Asks once per session about each new invitation. "Later" leaves it waiting in the Ledgers menu.</summary>
    private async Task PromptInvitationsAsync()
    {
        foreach (var invitation in _invitations.Where(i => _prompted.Add(i.MemberId)).ToList())
        {
            var answer = await Dialogs.ShowMessageBoxAsync($"{invitation.OwnerName} shared a ledger with you",
                $"Accept to see {invitation.OwnerName}'s accounts, bills and payments alongside your own, marked in their own color. " +
                "It's view only: you can't change anything in it. You can switch it off or leave it at any time.",
                yesText: "Accept", noText: "Decline", cancelText: "Later");
            if (answer is { } accept)
                await RespondAsync(invitation, accept);
        }
    }

    private async Task RespondAsync(LedgerInvitation invitation, bool accept)
    {
        await Ledger.RespondToInvitationAsync(invitation.MemberId, accept);
        Snackbar.Add(accept ? $"{invitation.OwnerName}'s ledger added. Switch it on or off from the Ledgers button." : "Invitation declined",
            accept ? Severity.Success : Severity.Info);
        await RefreshSharingAsync();
    }

    private async Task SetVisibleAsync(int? memberId, bool visible)
    {
        await Ledger.SetSharedVisibleAsync(memberId, visible);
        await RefreshSharingAsync();
    }

    // Ledger changes reload the app so every page and cached value reflects the new ledger.
    private async Task SwitchLedgerAsync(bool sample)
    {
        if (_ledger?.IsSample == sample)
            return;
        await Ledger.SwitchLedgerAsync(sample);
        Navigation.NavigateTo("", forceLoad: true);
    }

    private async Task StartSampleAsync()
    {
        if (_hasSample)
        {
            var confirmed = await Dialogs.ShowMessageBoxAsync("Start sample data over?",
                "This replaces the sample data, including any changes you made to it, with a fresh copy. Your own ledger isn't affected.",
                yesText: "Start over", cancelText: "Cancel");
            if (confirmed != true)
                return;
        }

        await Ledger.StartSampleAsync();
        Navigation.NavigateTo("", forceLoad: true);
    }

    private async Task DeleteSampleAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Delete sample data?",
            "This deletes all sample accounts, bills, income and loans and takes you back to your own ledger. Your own ledger isn't affected.",
            yesText: "Delete sample data", cancelText: "Cancel");
        if (confirmed != true)
            return;

        await Ledger.DeleteSampleAsync();
        Navigation.NavigateTo("", forceLoad: true);
    }

    private async Task AddTransactionAsync()
    {
        if (await TransactionDialog.ShowAsync(Dialogs))
        {
            Snackbar.Add("Transaction added", Severity.Success);
            _bodyVersion++;
        }
    }

    private async Task SignOutAsync() => await JS.InvokeVoidAsync("ledgerly.submitForm", "logout-form");
}
