@page "/transactions"
@inject LedgerService Ledger
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Transactions · Ledgerly</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4">Transactions</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">One-off spending and deposits that aren't bills, like dinner out or a refund.</MudText>
    </MudStack>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditAsync(null)">Add transaction</MudButton>
</MudStack>

<MudPaper Elevation="1" Class="pa-3 mb-3">
    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudSelect T="Period" @bind-Value="_period" Label="Period" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:170px" ToStringFunc="Describe">
            @foreach (var period in Enum.GetValues<Period>())
            {
                <MudSelectItem T="Period" Value="period">@Describe(period)</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int?" @bind-Value="AccountFilter" Label="Account" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:200px"
                   ToStringFunc="@(id => id is null ? "All accounts" : _accounts.FirstOrDefault(a => a.Id == id)?.Name ?? "")">
            <MudSelectItem T="int?" Value="null">All accounts</MudSelectItem>
            @foreach (var account in _accounts)
            {
                <MudSelectItem T="int?" Value="account.Id">@account.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int?" @bind-Value="_categoryFilter" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:190px"
                   ToStringFunc="@(id => id switch { null => "All categories", 0 => "Uncategorized", _ => _categories.FirstOrDefault(c => c.Id == id)?.Name ?? "" })">
            <MudSelectItem T="int?" Value="null">All categories</MudSelectItem>
            @foreach (var category in _categories)
            {
                <MudSelectItem T="int?" Value="category.Id"><CategoryChip Category="category" /></MudSelectItem>
            }
            <MudSelectItem T="int?" Value="0">Uncategorized</MudSelectItem>
        </MudSelect>
        <MudTextField @bind-Value="_search" Label="Search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="min-width:200px" />
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    return;
}

@{
    var shown = Filtered.ToList();
    var spent = shown.Where(t => t.IsSpent).ToList();
    var received = shown.Where(t => !t.IsSpent).ToList();
}

<MudGrid Spacing="3" Class="mb-1">
    <MudItem xs="12" sm="4">
        <StatCard Label="Spent" Icon="@Icons.Material.Filled.ShoppingBag" IconColor="Color.Error">
            <Value><Money Value="spent.Sum(t => t.Amount)" Colored="false" /></Value>
            <Caption>@Plural(spent.Count, "transaction")</Caption>
        </StatCard>
    </MudItem>
    <MudItem xs="12" sm="4">
        <StatCard Label="Received" Icon="@Icons.Material.Filled.Savings" IconColor="Color.Success">
            <Value><Money Value="received.Sum(t => t.Amount)" Colored="false" /></Value>
            <Caption>@Plural(received.Count, "transaction")</Caption>
        </StatCard>
    </MudItem>
    <MudItem xs="12" sm="4">
        <StatCard Label="Net" Icon="@Icons.Material.Filled.Balance">
            <Value><Money Value="shown.Sum(t => t.SignedAmount)" /></Value>
            <Caption>@(From is { } from ? $"{from:MMM d} – {To:MMM d, yyyy}" : "All time")</Caption>
        </StatCard>
    </MudItem>
</MudGrid>

<MudGrid Spacing="3">
    <MudItem xs="12" lg="9">
        <MudPaper Elevation="1">
            <MudTable T="Transaction" Items="shown" GroupBy="_byMonth" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm"
                      GroupHeaderClass="mud-background-gray" OnRowClick="@(e => EditAsync(e.Item))" RowStyle="cursor:pointer">
                <HeaderContent>
                    <MudTh>Date</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh>Account</MudTh>
                    <MudTh Style="text-align:right">Amount</MudTh>
                </HeaderContent>
                <GroupHeaderTemplate>
                    <MudTd colspan="3"><strong>@(((DateOnly)context.Key!).ToString("MMMM yyyy"))</strong></MudTd>
                    <MudTd Style="text-align:right"><strong><Money Value="context.Items.Sum(t => t.SignedAmount)" /></strong></MudTd>
                </GroupHeaderTemplate>
                <RowTemplate>
                    <MudTd DataLabel="Date">
                        <MudText Typo="Typo.body2">@Display.ShortDate(context.Date)</MudText>
                        @if (context.Date > Ledger.Today)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">planned</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Description">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.body2">@context.Description</MudText>
                            <CategoryChip Category="context.Category" />
                        </MudStack>
                        @if (context.Payee is not null || !string.IsNullOrWhiteSpace(context.Notes))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@string.Join(" · ", new[] { context.Payee?.Name, context.Notes }.Where(s => !string.IsNullOrWhiteSpace(s)))</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Account">@context.Account?.Name</MudTd>
                    <MudTd DataLabel="Amount" Style="text-align:right; white-space:nowrap"><Money Value="context.SignedAmount" /></MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="py-6 mud-text-secondary">
                        @(_transactions.Count == 0
                            ? "No transactions yet. Use Add transaction here, or the + button at the top of any page, to log a purchase as you make it."
                            : "No transactions match these filters.")
                    </MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="3">
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-2">Spending by category</MudText>
            @if (spent.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Nothing spent in this period.</MudText>
            }
            @{
                var total = spent.Sum(t => t.Amount);
            }
            @foreach (var group in spent.GroupBy(t => t.Category?.Id).Select(g => (Category: g.First().Category, Total: g.Sum(t => t.Amount), Count: g.Count())).OrderByDescending(g => g.Total))
            {
                <div class="mb-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        @if (group.Category is null)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Uncategorized</MudText>
                        }
                        else
                        {
                            <CategoryChip Category="group.Category" />
                        }
                        <MudText Typo="Typo.body2">@group.Total.ToString("C")</MudText>
                    </MudStack>
                    <MudProgressLinear Value="@(total > 0 ? (double)(group.Total / total * 100m) : 0)" Color="Color.Primary" Rounded="true" Class="mt-1" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Plural(group.Count, "transaction")</MudText>
                </div>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private enum Period { ThisMonth, LastMonth, Last3Months, ThisYear, LastYear, All }

    [SupplyParameterFromQuery(Name = "account")] private int? AccountFilter { get; set; }

    private bool _loading = true;
    private List<Transaction> _transactions = [];
    private List<Account> _accounts = [];
    private List<Category> _categories = [];
    private Period _period = Period.ThisMonth;
    private int? _categoryFilter;
    private string? _search;

    private readonly TableGroupDefinition<Transaction> _byMonth = new()
    {
        Selector = t => new DateOnly(t.Date.Year, t.Date.Month, 1)
    };

    private DateOnly Today => Ledger.Today;
    private DateOnly MonthStart => new(Today.Year, Today.Month, 1);

    private DateOnly? From => _period switch
    {
        Period.ThisMonth => MonthStart,
        Period.LastMonth => MonthStart.AddMonths(-1),
        Period.Last3Months => MonthStart.AddMonths(-2),
        Period.ThisYear => new DateOnly(Today.Year, 1, 1),
        Period.LastYear => new DateOnly(Today.Year - 1, 1, 1),
        _ => null
    };

    private DateOnly? To => _period switch
    {
        Period.ThisMonth or Period.Last3Months => MonthStart.AddMonths(1).AddDays(-1),
        Period.LastMonth => MonthStart.AddDays(-1),
        Period.ThisYear => new DateOnly(Today.Year, 12, 31),
        Period.LastYear => new DateOnly(Today.Year - 1, 12, 31),
        _ => null
    };

    private IEnumerable<Transaction> Filtered => _transactions.Where(t =>
        (From is null || t.Date >= From) && (To is null || t.Date <= To)
        && (AccountFilter is null || t.AccountId == AccountFilter)
        && (_categoryFilter is null || (t.CategoryId ?? 0) == _categoryFilter)
        && (string.IsNullOrWhiteSpace(_search)
            || t.Description.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase)
            || t.Payee?.Name.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase) == true
            || t.Notes?.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase) == true));

    private static string Describe(Period period) => period switch
    {
        Period.ThisMonth => "This month",
        Period.LastMonth => "Last month",
        Period.Last3Months => "Last 3 months",
        Period.ThisYear => "This year",
        Period.LastYear => "Last year",
        _ => "All time"
    };

    private static string Plural(int count, string noun) => $"{count} {noun}{(count == 1 ? "" : "s")}";

    protected override async Task OnInitializedAsync()
    {
        _accounts = await Ledger.GetAccountsAsync();
        _categories = await Ledger.GetCategoriesAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _transactions = await Ledger.GetTransactionsAsync();
        _loading = false;
    }

    private async Task EditAsync(Transaction? transaction)
    {
        if (await TransactionDialog.ShowAsync(Dialogs, transaction))
        {
            if (transaction is null)
                Snackbar.Add("Transaction added", Severity.Success);
            await LoadAsync();
        }
    }
}
