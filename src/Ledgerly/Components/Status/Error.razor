@page "/Error"
@using System.Diagnostics
@using Ledgerly.Components.Account.Shared
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout

<PageTitle>Error · Ledgerly</PageTitle>

<div class="acct-card">
    <h1 class="acct-title">Something went wrong</h1>
    <p class="acct-lead">An error occurred while processing your request.</p>
    @if (ShowRequestId)
    {
        <p class="acct-help">Request ID: <code>@RequestId</code></p>
    }
    <a href="" class="acct-btn acct-btn-primary acct-btn-block">Go to dashboard</a>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
