@inject LedgerService Ledger

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Due.Bill.Name</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @if (Due.Bill.CardAccountId is not null)
            {
                <text>Due @Display.Date(Due.DueDate) · @Display.Of(Due.Bill.CardPaymentRule).ToLowerInvariant(), estimated @Due.Amount.ToString("C")</text>
            }
            else
            {
                <text>Due @Display.Date(Due.DueDate) · expected @Due.Bill.ExpectedAmount.ToString("C")@(Due.Bill.MaxAmount is { } max && Due.Bill.IsVariable ? $" – {max:C}" : "")</text>
            }
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudNumericField @bind-Value="_amount" Label="Amount" Format="N2" Min="0m" Adornment="Adornment.Start" AdornmentText="$" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Immediate="true"
                                 HelperText="Actual or known amount. Blank uses the expected amount." />
            </MudItem>
            <MudItem xs="12" sm="6" Class="d-flex align-center">
                <MudSwitch @bind-Value="_isPaid" Label="Paid" Color="Color.Success" />
            </MudItem>
            @if (_isPaid)
            {
                <MudItem xs="12" sm="6">
                    <DateOnlyPicker @bind-Value="_paidOn" Label="Paid on" Required="true" />
                </MudItem>
            }

            @if (Due.Bill.Loan is { } loan)
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2">Payment on @loan.Name</MudText>
                    <MudRadioGroup T="LoanPaymentKind" @bind-Value="_kind">
                        <MudRadio T="LoanPaymentKind" Value="LoanPaymentKind.MonthlyPayment" Color="Color.Primary">Monthly payment</MudRadio>
                        <MudRadio T="LoanPaymentKind" Value="LoanPaymentKind.ExtraPrincipal" Color="Color.Primary">Extra payment toward principal</MudRadio>
                    </MudRadioGroup>
                    <MudAlert Severity="@(Extra > 0 ? Severity.Success : Severity.Normal)" Dense="true" Variant="Variant.Outlined" Class="mt-1">
                        @if (_kind == LoanPaymentKind.ExtraPrincipal)
                        {
                            <text>All @EffectiveAmount.ToString("C") goes toward the principal balance.</text>
                        }
                        else if (Extra > 0)
                        {
                            <text>@((EffectiveAmount - Extra).ToString("C")) monthly payment + <strong>@Extra.ToString("C") extra toward principal</strong>.</text>
                        }
                        else
                        {
                            <text>Counts as this month's payment. Pay more than @Due.Bill.ExpectedAmount.ToString("C") and the difference goes toward principal.</text>
                        }
                    </MudAlert>
                </MudItem>
            }

            <MudItem xs="12">
                <MudTextField @bind-Value="_notes" Label="Notes" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public BillDue Due { get; set; } = null!;

    /// <summary>Open with "Paid" switched on, for the quick "mark paid" action.</summary>
    [Parameter] public bool MarkPaid { get; set; }

    private decimal? _amount;
    private bool _isPaid;
    private DateOnly? _paidOn;
    private string? _notes;
    private LoanPaymentKind _kind;

    private decimal EffectiveAmount => _amount ?? Due.Bill.ExpectedAmount;
    private decimal Extra => LoanPayments.ExtraPortion(Due.Bill, _kind, EffectiveAmount);

    protected override void OnInitialized()
    {
        _amount = Due.Occurrence?.Amount;
        _isPaid = Due.IsPaid || MarkPaid;
        _paidOn = Due.Occurrence?.PaidOn ?? Min(Ledger.Today, Due.DueDate);
        _notes = Due.Occurrence?.Notes;
        _kind = LoanPayments.KindOf(Due.Bill, Due.Occurrence);
    }

    private static DateOnly Min(DateOnly a, DateOnly b) => a < b ? a : b;

    private async Task SaveAsync()
    {
        if (_isPaid && _paidOn is null)
            return;

        // Only store the payment type when it differs from the bill's, so changing the bill later still applies.
        LoanPaymentKind? kindOverride = Due.Bill.LoanId is not null && _kind != Due.Bill.LoanPaymentKind ? _kind : null;
        await Ledger.RecordOccurrenceAsync(Due.Bill.Id, Due.DueDate, _amount, _isPaid ? _paidOn : null, _notes, kindOverride);
        MudDialog.Close(DialogResult.Ok(true));
    }
}
