@inject LedgerService Ledger
@inject IDialogService Dialogs

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Name" Label="Bill name" Required="true" RequiredError="Name is required" MaxLength="100" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <PayeePicker @bind-Value="Model.PayeeId" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudSelect T="int?" @bind-Value="Model.CategoryId" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   ToStringFunc="@(id => _categories.FirstOrDefault(c => c.Id == id)?.Name ?? "None")">
                            <MudSelectItem T="int?" Value="null">None</MudSelectItem>
                            @foreach (var category in _categories)
                            {
                                <MudSelectItem T="int?" Value="category.Id"><CategoryChip Category="category" /></MudSelectItem>
                            }
                        </MudSelect>
                        <MudTooltip Text="New category">
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddCategoryAsync" aria-label="New category" />
                        </MudTooltip>
                    </MudStack>
                </MudItem>

                @if (IsCardPayment && Model.CardPaymentRule != CardPaymentRule.FixedAmount)
                {
                    <MudItem xs="12" sm="8">
                        <MudAlert Severity="Severity.Normal" Dense="true" Variant="Variant.Outlined">
                            The amount is worked out from the card each month: @(Model.CardPaymentRule == CardPaymentRule.StatementBalance ? "the full statement balance" : "the minimum payment").
                        </MudAlert>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="4">
                        <MudNumericField @bind-Value="Model.ExpectedAmount" Label="@(IsCardPayment ? "Payment amount" : "Expected amount")" Format="N2" Min="0m" Adornment="Adornment.Start" AdornmentText="$" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        @if (!IsCardPayment)
                        {
                            <MudNumericField @bind-Value="Model.MaxAmount" Label="Up to (optional)" Format="N2" Min="0m" Adornment="Adornment.Start" AdornmentText="$" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                                             HelperText="For bills that vary, like utilities" Validation="@(new Func<decimal?, string?>(ValidateMax))" />
                        }
                    </MudItem>
                }
                <MudItem xs="12" sm="4">
                    <MudSelect @bind-Value="Model.Frequency" Label="Repeats" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var frequency in Enum.GetValues<Frequency>())
                        {
                            <MudSelectItem Value="frequency">@Display.Of(frequency)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <DateOnlyPicker @bind-Value="_startDate" Label="@(Model.Frequency == Frequency.Once ? "Due date" : "First due date")" Required="true"
                                    HelperText="@(Model.Frequency == Frequency.Once ? null : "Later due dates repeat from this one")" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (Model.Frequency != Frequency.Once)
                    {
                        <DateOnlyPicker @bind-Value="_endDate" Label="Last due date (optional)" Clearable="true" />
                    }
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" @bind-Value="Model.PayFromAccountId" Label="@(IsCardPayment ? "Paid from account" : "Paid from (account or card)")" Variant="Variant.Outlined" Margin="Margin.Dense"
                               ToStringFunc="@(id => _accounts.FirstOrDefault(a => a.Id == id)?.Name ?? "Not assigned")"
                               HelperText="@(_accounts.Count == 0 ? "Add an account first to project balances" : null)">
                        <MudSelectItem T="int?" Value="null">Not assigned</MudSelectItem>
                        @foreach (var account in _accounts.Where(a => !IsCardPayment || !a.IsCreditCard))
                        {
                            <MudSelectItem T="int?" Value="account.Id">@account.Name@(account.IsCreditCard ? " (credit card)" : "")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Value="PaysOff" ValueChanged="OnPaysOffChanged" Label="Pays off a loan or card (optional)" Variant="Variant.Outlined" Margin="Margin.Dense"
                               ToStringFunc="DescribePaysOff">
                        <MudSelectItem T="string" Value="@("")">None</MudSelectItem>
                        @foreach (var loan in _loans)
                        {
                            <MudSelectItem T="string" Value="@($"loan:{loan.Id}")">@loan.Name (loan)</MudSelectItem>
                        }
                        @foreach (var card in _cards)
                        {
                            <MudSelectItem T="string" Value="@($"card:{card.Id}")">@card.Name (credit card)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @if (IsCardPayment)
                {
                    <MudItem xs="12">
                        <MudRadioGroup T="CardPaymentRule" @bind-Value="Model.CardPaymentRule">
                            <MudRadio T="CardPaymentRule" Value="CardPaymentRule.StatementBalance" Color="Color.Primary">Pay the statement in full</MudRadio>
                            <MudRadio T="CardPaymentRule" Value="CardPaymentRule.Minimum" Color="Color.Primary">Pay the minimum</MudRadio>
                            <MudRadio T="CardPaymentRule" Value="CardPaymentRule.FixedAmount" Color="Color.Primary">Pay a fixed amount</MudRadio>
                        </MudRadioGroup>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            The payment comes out of the paid-from account and lowers what you owe on the card. Record the actual amount when you mark it paid.
                        </MudText>
                    </MudItem>
                }

                @if (Model.LoanId is not null)
                {
                    <MudItem xs="12">
                        <MudRadioGroup T="LoanPaymentKind" Value="Model.LoanPaymentKind" ValueChanged="OnKindChanged">
                            <MudRadio T="LoanPaymentKind" Value="LoanPaymentKind.MonthlyPayment" Color="Color.Primary">The monthly loan payment</MudRadio>
                            <MudRadio T="LoanPaymentKind" Value="LoanPaymentKind.ExtraPrincipal" Color="Color.Primary">An extra payment toward principal</MudRadio>
                        </MudRadioGroup>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @(Model.LoanPaymentKind == LoanPaymentKind.ExtraPrincipal
                                ? "The whole amount lowers the loan balance when it's paid (or on its due date with autopay)."
                                : "Paying more than this bill's amount counts the difference as extra toward principal. You can change the type when marking a payment paid.")
                        </MudText>
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    <MudSwitch @bind-Value="Model.AutoPay" Label="Autopay" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSwitch @bind-Value="Model.IsActive" Label="Active" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.Notes" Label="Notes" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                @if (_error is not null)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Bill Model { get; set; } = new();

    private MudForm _form = null!;
    private List<Category> _categories = [];
    private List<Account> _accounts = [];
    private List<Loan> _loans = [];
    private List<Account> _cards = [];
    private DateOnly? _startDate;
    private DateOnly? _endDate;
    private string? _error;

    /// <summary>Prefills the first due date, e.g. when setting up a card's payment from the card page.</summary>
    [Parameter] public DateOnly? SuggestedStartDate { get; set; }

    private bool IsCardPayment => Model.CardAccountId is not null;

    private string PaysOff => Model.LoanId is { } loanId ? $"loan:{loanId}" : Model.CardAccountId is { } cardId ? $"card:{cardId}" : "";

    protected override async Task OnInitializedAsync()
    {
        _startDate = Model.Id == 0 ? SuggestedStartDate : Model.StartDate;
        _endDate = Model.EndDate;
        _categories = await Ledger.GetCategoriesAsync();
        _accounts = await Ledger.GetAccountsAsync(activeOnly: true);
        _cards = (await Ledger.GetAccountsAsync()).Where(a => a.IsCreditCard && (a.IsActive || a.Id == Model.CardAccountId)).ToList();
        _loans = (await Ledger.GetLoansAsync()).Where(l => l.IsActive || l.Id == Model.LoanId).ToList();

        if (Model.Id == 0 && Model.PayFromAccountId is null && _accounts.FirstOrDefault(a => a.Type == AccountType.Checking) is { } checking)
            Model.PayFromAccountId = checking.Id;
    }

    private string DescribePaysOff(string? value) => value switch
    {
        null or "" => "None",
        _ when value.StartsWith("loan:") => _loans.FirstOrDefault(l => $"loan:{l.Id}" == value)?.Name ?? "",
        _ => _cards.FirstOrDefault(c => $"card:{c.Id}" == value)?.Name ?? ""
    };

    private void OnPaysOffChanged(string? value)
    {
        int? IdAfter(string prefix) => value?.StartsWith(prefix) == true && int.TryParse(value[prefix.Length..], out var id) ? id : null;

        Model.CardAccountId = IdAfter("card:");
        if (Model.CardAccountId is null)
        {
            OnLoanChanged(IdAfter("loan:"));
            return;
        }

        Model.LoanId = null;
        if (_cards.FirstOrDefault(c => c.Id == Model.CardAccountId) is not { } card)
            return;

        // Prefill from the card when the bill is still blank, and never pay a card from a card.
        if (string.IsNullOrWhiteSpace(Model.Name))
            Model.Name = $"{card.Name} payment";
        if (_accounts.FirstOrDefault(a => a.Id == Model.PayFromAccountId)?.IsCreditCard == true)
            Model.PayFromAccountId = _accounts.FirstOrDefault(a => a.Type == AccountType.Checking)?.Id;
        Model.MaxAmount = null;
    }

    private async Task AddCategoryAsync()
    {
        var parameters = new DialogParameters<CategoryDialog>
        {
            { d => d.Model, new Category { Color = CategoryChip.Palette[_categories.Count % CategoryChip.Palette.Length] } }
        };
        var dialog = await Dialogs.ShowAsync<CategoryDialog>("New category", parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: int id })
        {
            _categories = await Ledger.GetCategoriesAsync();
            Model.CategoryId = id;
        }
    }

    private string? ValidateMax(decimal? max) =>
        max is { } m && m < Model.ExpectedAmount ? "Must be at least the expected amount" : null;

    private void OnLoanChanged(int? loanId)
    {
        Model.LoanId = loanId;
        if (_loans.FirstOrDefault(l => l.Id == loanId) is not { } loan)
            return;

        // Prefill from the loan when the bill is still blank.
        Model.PayeeId ??= loan.LenderId;
        if (Model.LoanPaymentKind == LoanPaymentKind.ExtraPrincipal)
        {
            if (string.IsNullOrWhiteSpace(Model.Name))
                Model.Name = $"{loan.Name} extra payment";
            _startDate ??= Ledger.Today;
            return;
        }

        if (string.IsNullOrWhiteSpace(Model.Name))
            Model.Name = loan.Name;
        if (Model.ExpectedAmount == 0)
            Model.ExpectedAmount = LoanMath.Payment(loan) + loan.ExtraPrincipal;
        _startDate ??= loan.FirstPaymentDate;
    }

    private void OnKindChanged(LoanPaymentKind kind)
    {
        var previous = Model.LoanPaymentKind;
        Model.LoanPaymentKind = kind;
        if (_loans.FirstOrDefault(l => l.Id == Model.LoanId) is not { } loan || previous == kind)
            return;

        // Swap the prefilled name and amount if they still match what the other type suggested.
        var monthlyAmount = LoanMath.Payment(loan) + loan.ExtraPrincipal;
        if (kind == LoanPaymentKind.ExtraPrincipal)
        {
            if (Model.Name == loan.Name)
                Model.Name = $"{loan.Name} extra payment";
            if (Model.ExpectedAmount == monthlyAmount)
                Model.ExpectedAmount = 0;
        }
        else
        {
            if (Model.Name == $"{loan.Name} extra payment")
                Model.Name = loan.Name;
            if (Model.ExpectedAmount == 0)
                Model.ExpectedAmount = monthlyAmount;
        }
    }

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || _startDate is null)
            return;

        Model.StartDate = _startDate.Value;
        Model.EndDate = Model.Frequency == Frequency.Once ? null : _endDate;
        try
        {
            await Ledger.SaveBillAsync(Model);
            MudDialog.Close(DialogResult.Ok(Model.Id));
        }
        catch (LedgerValidationException ex)
        {
            _error = ex.Message;
        }
    }
}
