@inject LedgerService Ledger

<MudDialog>
    <DialogContent>
        @if (_accounts.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mb-3">Add an account first so income has somewhere to go.</MudAlert>
        }
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="Model.Name" Label="Name" Required="true" RequiredError="Name is required" MaxLength="100" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField @bind-Value="Model.Amount" Label="Amount" Format="N2" Min="0m" Adornment="Adornment.Start" AdornmentText="$" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="Model.Frequency" Label="Repeats" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var frequency in Enum.GetValues<Frequency>())
                        {
                            <MudSelectItem Value="frequency">@Display.Of(frequency)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" @bind-Value="Model.DepositToAccountId" Label="Deposited to" Required="true" RequiredError="Choose an account" Variant="Variant.Outlined" Margin="Margin.Dense"
                               ToStringFunc="@(id => _accounts.FirstOrDefault(a => a.Id == id)?.Name ?? "")">
                        @foreach (var account in _accounts)
                        {
                            <MudSelectItem T="int" Value="account.Id">@account.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <DateOnlyPicker @bind-Value="_startDate" Label="@(Model.Frequency == Frequency.Once ? "Date" : "First date")" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    @if (Model.Frequency != Frequency.Once)
                    {
                        <DateOnlyPicker @bind-Value="_endDate" Label="Last date (optional)" Clearable="true" />
                    }
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch @bind-Value="Model.IsActive" Label="Active" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.Notes" Label="Notes" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_accounts.Count == 0">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Income Model { get; set; } = new();

    private MudForm _form = null!;
    private List<Account> _accounts = [];
    private DateOnly? _startDate;
    private DateOnly? _endDate;

    protected override async Task OnInitializedAsync()
    {
        _startDate = Model.Id == 0 ? null : Model.StartDate;
        _endDate = Model.EndDate;
        _accounts = (await Ledger.GetAccountsAsync()).Where(a => a.IsActive || a.Id == Model.DepositToAccountId).ToList();

        var preferred = _accounts.FirstOrDefault(a => a.Type == AccountType.Checking) ?? _accounts.FirstOrDefault();
        if (Model.DepositToAccountId == 0 && preferred is not null)
            Model.DepositToAccountId = preferred.Id;
    }

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || _startDate is null || Model.DepositToAccountId == 0)
            return;

        Model.StartDate = _startDate.Value;
        Model.EndDate = Model.Frequency == Frequency.Once ? null : _endDate;
        await Ledger.SaveIncomeAsync(Model);
        MudDialog.Close(DialogResult.Ok(Model.Id));
    }
}
