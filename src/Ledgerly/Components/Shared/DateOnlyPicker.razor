@* MudDatePicker works with DateTime?; this adapts it to DateOnly? for the data model.
   AutoClose because MudBlazor defaults it to false, leaving the calendar open over the form after a date is picked. *@
<MudDatePicker Label="@Label"
               Date="@Value?.ToDateTime(TimeOnly.MinValue)"
               DateChanged="OnDateChanged"
               Required="Required"
               RequiredError="@($"{Label} is required")"
               Clearable="Clearable"
               HelperText="@HelperText"
               Editable="true"
               AutoClose="true"
               Variant="Variant.Outlined"
               Margin="Margin.Dense" />

@code {
    [Parameter] public DateOnly? Value { get; set; }
    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Clearable { get; set; }

    private Task OnDateChanged(DateTime? date) =>
        ValueChanged.InvokeAsync(date is { } d ? DateOnly.FromDateTime(d) : null);
}
