@using System.Globalization
@inject LedgerService Ledger
@inject IDialogService Dialogs

@* Month grid on wider screens; a list of days with bills on phones (switched in app.css). *@
<div class="cal-grid" role="grid" aria-label="@($"Bills in {Month:MMMM yyyy}")">
    @foreach (var weekday in Weekdays)
    {
        <div class="cal-weekday" role="columnheader">@CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(weekday)</div>
    }
    @for (var date = _gridStart; date <= _gridEnd; date = date.AddDays(1))
    {
        var day = date;
        var dues = DuesOn(day);
        var incomes = IncomesOn(day);
        <div class="@DayClass(day)" role="gridcell">
            <div class="cal-day-head">
                <span class="cal-date" aria-label="@day.ToString("D")">@day.Day</span>
                @if (dues.Count > 0)
                {
                    <span class="cal-day-total">@dues.Sum(d => d.Amount).ToString("C0")</span>
                }
            </div>
            @foreach (var income in incomes)
            {
                <div class="cal-item income" title="@($"{income.Name}: +{income.Amount:C}")">
                    <span class="cal-name">@income.Name</span><span class="cal-amount">+@income.Amount.ToString("C0")</span>
                </div>
            }
            @foreach (var due in dues)
            {
                @DueButton(due)
            }
        </div>
    }
</div>

<div class="cal-agenda">
    @{
        var anything = false;
    }
    @for (var date = Month; date < Month.AddMonths(1); date = date.AddDays(1))
    {
        var day = date;
        var dues = DuesOn(day);
        var incomes = IncomesOn(day);
        if (dues.Count == 0 && incomes.Count == 0)
            continue;
        anything = true;
        <div class="@($"cal-agenda-day{(day == Ledger.Today ? " today" : "")}")">
            <div class="cal-day-head">
                <strong>@Display.ShortDate(day)</strong>
                <span class="cal-day-total">@(dues.Count > 0 ? dues.Sum(d => d.Amount).ToString("C") : "")</span>
            </div>
            @foreach (var income in incomes)
            {
                <div class="cal-item income"><span class="cal-name">@income.Name</span><span class="cal-amount">+@income.Amount.ToString("C")</span></div>
            }
            @foreach (var due in dues)
            {
                @DueButton(due, "C")
            }
        </div>
    }
    @if (!anything)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">Nothing due this month.</MudText>
    }
</div>

<div class="cal-legend">
    <span class="cal-item unpaid">Unpaid</span>
    <span class="cal-item overdue">Overdue</span>
    <span class="cal-item autopay">Autopay</span>
    <span class="cal-item paid">Paid</span>
    @if (Incomes is not null)
    {
        <span class="cal-item income">Income</span>
    }
    <MudText Typo="Typo.caption" Class="mud-text-secondary">Click a bill to record the amount or mark it paid.</MudText>
</div>

@code {
    /// <summary>The first day of the month to show.</summary>
    [Parameter, EditorRequired] public DateOnly Month { get; set; }

    [Parameter, EditorRequired] public IEnumerable<Bill> Bills { get; set; } = [];

    /// <summary>Income to show alongside bills, or null to leave it out.</summary>
    [Parameter] public IEnumerable<Income>? Incomes { get; set; }

    [Parameter] public EventCallback OnChanged { get; set; }

    private DateOnly _gridStart;
    private DateOnly _gridEnd;
    private ILookup<DateOnly, BillDue> _dues = Enumerable.Empty<BillDue>().ToLookup(d => d.DueDate);
    private ILookup<DateOnly, Income> _incomes = Enumerable.Empty<Income>().ToLookup(i => i.StartDate);

    private static IEnumerable<DayOfWeek> Weekdays
    {
        get
        {
            var first = (int)CultureInfo.CurrentCulture.DateTimeFormat.FirstDayOfWeek;
            return Enumerable.Range(0, 7).Select(i => (DayOfWeek)((first + i) % 7));
        }
    }

    protected override void OnParametersSet()
    {
        // Whole weeks, starting on the culture's first day of the week.
        var first = (int)CultureInfo.CurrentCulture.DateTimeFormat.FirstDayOfWeek;
        _gridStart = Month.AddDays(-(((int)Month.DayOfWeek - first + 7) % 7));
        var monthEnd = Month.AddMonths(1).AddDays(-1);
        _gridEnd = monthEnd.AddDays((first + 6 - (int)monthEnd.DayOfWeek + 7) % 7);

        _dues = BillSchedule.Between(Bills, _gridStart, _gridEnd).ToLookup(d => d.DueDate);
        _incomes = (Incomes ?? [])
            .Where(i => i.IsActive)
            .SelectMany(i => Recurrence.Dates(i.Frequency, i.StartDate, i.EndDate, _gridStart, _gridEnd).Select(date => (date, i)))
            .ToLookup(x => x.date, x => x.i);
    }

    private List<BillDue> DuesOn(DateOnly day) => _dues[day].ToList();

    private List<Income> IncomesOn(DateOnly day) => _incomes[day].OrderBy(i => i.Name).ToList();

    private string DayClass(DateOnly day) =>
        "cal-day" + (day.Month != Month.Month ? " outside" : "") + (day == Ledger.Today ? " today" : "");

    private string Status(BillDue due) =>
        due.IsPaid ? "paid" : due.IsOverdue(Ledger.Today) ? "overdue" : due.Bill.AutoPay ? "autopay" : "unpaid";

    private string Describe(BillDue due) =>
        $"{due.Bill.Name}: {(due.IsEstimate ? "about " : "")}{due.Amount:C} · " + Status(due) switch
        {
            "paid" => $"paid {due.Occurrence!.PaidOn:MMM d}",
            "overdue" => "overdue",
            "autopay" => "autopay",
            _ => "unpaid"
        } + (due.Bill.PayFromAccount is { } account ? $" from {account.Name}" : "");

    private RenderFragment DueButton(BillDue due, string format = "C0") => @<button type="button" class="@($"cal-item {Status(due)}")" title="@Describe(due)" aria-label="@Describe(due)" @onclick="() => OpenAsync(due)">
        @if (due.IsPaid)
        {
            <MudIcon Icon="@Icons.Material.Filled.Check" Style="font-size:0.9rem" />
        }
        else if (due.Bill.Category?.Color is { } color)
        {
            <span class="category-dot" style="@($"background:{color}")"></span>
        }
        <span class="cal-name">@due.Bill.Name</span>
        <span class="cal-amount">@(due.IsEstimate ? "≈" : "")@due.Amount.ToString(format)</span>
    </button>;

    private async Task OpenAsync(BillDue due)
    {
        var parameters = new DialogParameters<RecordPaymentDialog>
        {
            { d => d.Due, due },
            { d => d.MarkPaid, !due.IsPaid && due.DueDate <= Ledger.Today }
        };
        var dialog = await Dialogs.ShowAsync<RecordPaymentDialog>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
            await OnChanged.InvokeAsync();
    }
}
