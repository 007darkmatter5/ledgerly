@* Marks something that belongs to a ledger shared with the user: a small lock (view only) or people icon (they can
   change things) in the ledger's color, placed after its name. The ledger, owner and access are in the tooltip and
   the screen-reader label. Renders nothing for the user's own ledger. *@
@if (Scope?.SharedFor(LedgerId) is { } shared)
{
    var label = $"{shared.Name}, shared by {shared.OwnerName}, {shared.AccessText}";
    <MudTooltip Text="@label">
        <span class="ledger-tag" style="@($"--ledger-color:{shared.Color}")" role="img" aria-label="@label">
            <MudIcon Icon="@(shared.IsReadOnly ? Icons.Material.Filled.Lock : Icons.Material.Filled.People)" Style="font-size:0.95rem" />
        </span>
    </MudTooltip>
}

@code {
    [CascadingParameter] public LedgerScope? Scope { get; set; }

    [Parameter, EditorRequired] public int LedgerId { get; set; }
}
