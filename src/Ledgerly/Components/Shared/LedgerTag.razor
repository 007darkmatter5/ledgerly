@* Marks something that belongs to a ledger shared with the user: their color, the ledger's name, and a lock when
   it's view only. Renders nothing for the user's own ledger. *@
@if (Scope?.SharedFor(LedgerId) is { } shared)
{
    <MudTooltip Text="@($"Shared by {shared.OwnerName}{(shared.IsReadOnly ? " · view only" : "")}")">
        <span class="ledger-tag" style="@($"--ledger-color:{shared.Color}")">
            @if (shared.IsReadOnly)
            {
                <MudIcon Icon="@Icons.Material.Filled.Lock" Style="font-size:0.8rem" />
            }
            else
            {
                <span class="ledger-dot"></span>
            }
            @shared.Name
        </span>
    </MudTooltip>
}

@code {
    [CascadingParameter] public LedgerScope? Scope { get; set; }

    [Parameter, EditorRequired] public int LedgerId { get; set; }
}
