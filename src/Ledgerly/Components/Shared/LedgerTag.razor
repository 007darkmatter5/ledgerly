@* Marks something that belongs to a ledger shared with the user: a small lock (or dot, once editing is allowed) in
   the ledger's color, placed after its name. The ledger and owner are in the tooltip and the screen-reader label.
   Renders nothing for the user's own ledger. *@
@if (Scope?.SharedFor(LedgerId) is { } shared)
{
    var label = $"{shared.Name}, shared by {shared.OwnerName}{(shared.IsReadOnly ? ", view only" : "")}";
    <MudTooltip Text="@label">
        <span class="ledger-tag" style="@($"--ledger-color:{shared.Color}")" role="img" aria-label="@label">
            <MudIcon Icon="@(shared.IsReadOnly ? Icons.Material.Filled.Lock : Icons.Material.Filled.People)" Style="font-size:0.95rem" />
        </span>
    </MudTooltip>
}

@code {
    [CascadingParameter] public LedgerScope? Scope { get; set; }

    [Parameter, EditorRequired] public int LedgerId { get; set; }
}
